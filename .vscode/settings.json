{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.png": false,
    "**/*.ico": false,
    "**/*.svg": false,
    "**/*.webmanifest": false
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/*.png": false,
    "**/*.ico": false,
    "**/*.svg": false,
    "**/*.webmanifest": false
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt"
}
